<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ description or 'Tiny Bite Books — a debut picture book about a cheese-loving toddler who meets five chatty cheese characters. For curious kids ages 2–6.' }}">
<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or 'Tiny Bite Books — a debut picture book about a cheese-loving toddler who meets five chatty cheese characters. For curious kids ages 2–6.' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}/assets/front-cover.jpg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description or 'Tiny Bite Books — a debut picture book about a cheese-loving toddler who meets five chatty cheese characters. For curious kids ages 2–6.' }}">
<meta name="twitter:image" content="{{ site.url }}/assets/front-cover.jpg">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
